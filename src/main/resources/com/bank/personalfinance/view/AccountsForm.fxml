<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="350.0" prefWidth="400.0" spacing="20.0"
      style="-fx-background-color: #1e1e1e; -fx-border-color: #333; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;"
      stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bank.personalfinance.controller.AccountsFormController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="YENİ HESAP OLUŞTUR" textFill="WHITE">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <VBox spacing="15.0" VBox.vgrow="ALWAYS">
        <VBox spacing="5.0">
            <Label text="Hesap Adı" textFill="#bdc3c7" />
            <TextField fx:id="txtAccountName" prefHeight="40.0" promptText="Örn: Tatil Fonu" styleClass="input-field" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Para Birimi" textFill="#bdc3c7" />
            <ComboBox fx:id="cmbCurrency" prefHeight="40.0" prefWidth="400.0" promptText="Seçiniz" />
        </VBox>

        <Label fx:id="lblError" textFill="#e74c3c" />
    </VBox>

    <HBox spacing="15.0">
        <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: transparent; -fx-border-color: #7f8c8d; -fx-border-radius: 20; -fx-text-fill: #bdc3c7; -fx-cursor: hand;" text="İptal" />
        <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="45.0" prefWidth="200.0" styleClass="action-btn, action-btn-primary" text="OLUŞTUR" />
    </HBox>

</VBox>