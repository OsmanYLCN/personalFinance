<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="content-area" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.personalfinance.controller.TransferController">
    <children>
        <VBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <Label text="PARA TRANSFERİ" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>

                <VBox maxWidth="500.0" spacing="20.0" style="-fx-background-color: #1e1e1e; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 10, 0, 0, 5);">
                    <children>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Gönderen Hesap" textFill="#bdc3c7">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="comboSourceAccount" prefHeight="45.0" prefWidth="460.0" promptText="Hesap Seçiniz" />                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Alıcı IBAN" textFill="#bdc3c7">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtTargetIban" prefHeight="45.0" promptText="TR..." style="-fx-background-color: #2c3e50; -fx-text-fill: #fdfdfd; -fx-background-radius: 10;" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Tutar (₺)" textFill="#bdc3c7">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtAmount" prefHeight="45.0" promptText="0.00" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-background-radius: 10;" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Açıklama (Opsiyonel)" textFill="#bdc3c7">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtDescription" prefHeight="45.0" promptText="Örn: Kira Ödemesi" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-background-radius: 10;" />
                            </children>
                        </VBox>

                        <Label fx:id="lblStatus" textFill="#e74c3c" wrapText="true">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>

                        <HBox spacing="15.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: transparent; -fx-border-color: #7f8c8d; -fx-border-radius: 30; -fx-text-fill: #bdc3c7; -fx-cursor: hand;" text="İptal" />

                                <Button fx:id="btnSend" mnemonicParsing="false" onAction="#handleTransfer" prefHeight="50.0" prefWidth="300.0" style="-fx-background-color: #00c6ff; -fx-background-radius: 30; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="GÖNDER" />
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>

                    </children>
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                    </padding>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>