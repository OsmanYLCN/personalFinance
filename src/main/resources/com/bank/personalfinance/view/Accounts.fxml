<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="content-area" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.personalfinance.controller.AccountsController">
    <children>
        <VBox prefHeight="720.0" prefWidth="1280.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" style="-fx-background-color: #1e1e1e; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 0, 0, 0, 5);">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 24px; -fx-cursor: hand;" text="⬅" />

                        <Label text="HESAPLARIM" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button mnemonicParsing="false" onAction="#handleCreateAccountDialog" prefHeight="45.0" prefWidth="180.0" styleClass="action-btn, action-btn-primary" text="+  Yeni Hesap Oluştur" />
                    </children>
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="cardsContainer" hgap="30.0" vgap="30.0" prefWrapLength="1200.0">
                            <padding>
                                <Insets bottom="50.0" left="50.0" right="50.0" top="30.0" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </children>
</AnchorPane>