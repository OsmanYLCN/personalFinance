<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="content-area" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.personalfinance.controller.TransactionsController">
    <children>
        <VBox prefHeight="720.0" prefWidth="1280.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" style="-fx-background-color: #1E1E1E; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 0, 0, 0, 5);">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 24px; -fx-cursor: hand;" text="⬅" />
                        <Label text="İŞLEM GEÇMİŞİ" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1E1E1E; -fx-background-radius: 15; -fx-padding: 20;">
                    <children>
                        <VBox spacing="5.0">
                            <Label text="Başlangıç Tarihi" textFill="#bdc3c7" />
                            <DatePicker fx:id="dateStart" prefWidth="150.0" styleClass="combo-box" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Bitiş Tarihi" textFill="#bdc3c7" />
                            <DatePicker fx:id="dateEnd" prefWidth="150.0" styleClass="combo-box" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="İşlem Türü" textFill="#bdc3c7" />
                            <ComboBox fx:id="comboType" prefWidth="150.0" styleClass="combo-box" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Kategori" textFill="#bdc3c7" />
                            <ComboBox fx:id="comboCategory" prefWidth="150.0" styleClass="combo-box" />
                        </VBox>

                        <Button mnemonicParsing="false" onAction="#handleFilter" prefHeight="40.0" prefWidth="120.0" styleClass="action-btn, action-btn-primary" text="FİLTRELE">
                            <HBox.margin><Insets top="20.0" /></HBox.margin>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#handleClearFilters" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-border-color: #7f8c8d; -fx-border-radius: 20; -fx-text-fill: #bdc3c7;" text="Temizle">
                            <HBox.margin><Insets top="20.0" /></HBox.margin>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets left="30.0" right="30.0" />
                    </VBox.margin>
                </HBox>

                <TableView fx:id="tableTransactions" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDate" prefWidth="150.0" text="TARİH" />
                        <TableColumn fx:id="colDesc" prefWidth="400.0" text="AÇIKLAMA" />
                        <TableColumn fx:id="colCategory" prefWidth="150.0" text="KATEGORİ" />
                        <TableColumn fx:id="colType" prefWidth="100.0" text="TÜR" />
                        <TableColumn fx:id="colAmount" prefWidth="150.0" text="TUTAR" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <VBox.margin>
                        <Insets bottom="30.0" left="30.0" right="30.0" />
                    </VBox.margin>
                </TableView>

            </children>
        </VBox>
    </children>
</AnchorPane>