<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="400.0" spacing="15.0"
      style="-fx-background-color: #1e1e1e; -fx-border-color: #333; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;"
      stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bank.personalfinance.controller.ExpenseFormController">

    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>

    <Label text="HARCAMA EKLE" textFill="WHITE"><font><Font name="System Bold" size="20.0" /></font></Label>

    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
        <Label text="Kategori" textFill="#bdc3c7" />
        <ComboBox fx:id="cmbCategory" prefHeight="40.0" prefWidth="400.0" promptText="Seçiniz" />

        <Label text="Tutar (₺)" textFill="#bdc3c7" />
        <TextField fx:id="txtAmount" prefHeight="40.0" promptText="0.00" styleClass="input-field" />

        <Label text="Açıklama" textFill="#bdc3c7" />
        <TextField fx:id="txtDescription" prefHeight="40.0" promptText="Örn: Migros Alışverişi" styleClass="input-field" />

        <Label fx:id="lblError" textFill="#e74c3c" wrapText="true" />
    </VBox>

    <HBox spacing="15.0">
        <Button onAction="#handleCancel" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: transparent; -fx-border-color: #7f8c8d; -fx-border-radius: 20; -fx-text-fill: #bdc3c7;" text="İptal" />
        <Button onAction="#handleSave" prefHeight="45.0" prefWidth="200.0" styleClass="action-btn, action-btn-danger" text="HARCA" />
    </HBox>
</VBox>