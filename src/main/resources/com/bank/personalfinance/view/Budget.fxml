<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="content-area" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.personalfinance.controller.BudgetController">
    <children>
        <VBox prefHeight="720.0" prefWidth="1280.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" style="-fx-background-color: #1e1e1e; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 0, 0, 0, 5);">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 24px; -fx-cursor: hand;" text="⬅" />
                        <Label text="BÜTÇE VE LİMİTLER" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleAddLimitDialog" prefHeight="45.0" prefWidth="180.0" styleClass="action-btn, action-btn-primary" text="+  Yeni Limit Ekle" />
                    </children>
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                </HBox>

                <HBox alignment="CENTER" spacing="30.0">
                    <children>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="300.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 5);">
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                            <children>
                                <Label text="TOPLAM BÜTÇE" textFill="#bdc3c7"><font><Font name="System Bold" size="14.0" /></font></Label>
                                <Label fx:id="lblTotalBudget" text="₺ 0.00" textFill="#3498db"><font><Font name="System Bold" size="24.0" /></font></Label>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="300.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 5);">
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                            <children>
                                <Label text="HARCANAN" textFill="#bdc3c7"><font><Font name="System Bold" size="14.0" /></font></Label>
                                <Label fx:id="lblTotalSpent" text="₺ 0.00" textFill="#e74c3c"><font><Font name="System Bold" size="24.0" /></font></Label>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="300.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 5);">
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                            <children>
                                <Label text="KALAN LİMİT" textFill="#bdc3c7"><font><Font name="System Bold" size="14.0" /></font></Label>
                                <Label fx:id="lblRemaining" text="₺ 0.00" textFill="#2ecc71"><font><Font name="System Bold" size="24.0" /></font></Label>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </VBox.margin>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="budgetContainer" spacing="15.0">
                            <padding>
                                <Insets bottom="50.0" left="100.0" right="100.0" top="20.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </children>
</AnchorPane>